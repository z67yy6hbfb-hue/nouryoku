rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function friendPairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function isAcceptedFriend(otherUid) {
      return exists(/databases/$(database)/documents/friendships/$(friendPairId(request.auth.uid, otherUid)))
        && get(/databases/$(database)/documents/friendships/$(friendPairId(request.auth.uid, otherUid))).data.status == 'accepted';
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // 属性プロフィールのみ、認証済みの誰でも読める公開ドキュメント
      match /public/profile {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /friendSettings/{friendUid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /emailIndex/{emailId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }

    match /friendships/{pairId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.uids);
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null && request.auth.uid in resource.data.uids;
      allow delete: if request.auth != null && request.auth.uid in resource.data.uids;
    }

    match /assessments/{assessmentId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.authorUid;
      allow read: if request.auth != null && (
        resource == null ||
        request.auth.uid == resource.data.authorUid ||
        request.auth.uid == resource.data.targetUid ||
        resource.data.visibility == 'public' ||
        (resource.data.visibility == 'friends' && isAcceptedFriend(resource.data.authorUid))
      );
      allow update: if request.auth != null && request.auth.uid == resource.data.authorUid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }
  }
}
